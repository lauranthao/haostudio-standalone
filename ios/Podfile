platform :ios, '15.0'

target 'HAoStudio' do
  # Static linkage: IJKMediaFramework is a vendored static framework.
  use_frameworks! :linkage => :static

  # Single native player for ALL live streams (HLS + FLV) and VOD:
  # ijkplayer (FFmpeg). Replaces MobileVLCKit (Huya's CDN blocks VLC's
  # HTTP client with 403) and AVPlayer (cannot decode FLV). One engine,
  # one UI, no double loading — like Pure Live.
  pod 'IJKMediaFramework', :git => 'https://github.com/lauranthao/IJKMediaFramework.git', :tag => '0.1.5'
end
